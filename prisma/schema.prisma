// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                            String          @id @default(auto()) @map("_id") @db.ObjectId
  name                          String
  avatarUrl                     String?
  email                         String          @unique
  phone                         String?
  city                          String?
  zip                           String?
  country                       String?
  password                      String
  stripeAccountId               String?
  paystackAccountCode           String?
  role                          UserRoleEnum
  storeCategory                 StoreCategory?
  emailVerificationToken        String?
  emailVerificationTokenExpires DateTime?
  address                       String?
  state                         String?
  forgotPasswordToken           String?
  forgotPasswordTokenExpires    DateTime?
  isEmailVerified               Boolean         @default(false)
  status                        UserStatus      @default(ACTIVE)
  createdAt                     DateTime        @default(now())
  updatedAt                     DateTime        @updatedAt
  sellerDocs                    String[]
  Transactions                  Transaction[]
  Reviews                       Review[]
  Notifications                 Notifications[]
  Products                      Product[]
  BuyerOrders                   Order[]         @relation("buyer")
  SellerOrders                  Order[]         @relation("seller")
  Category                      Category[]

  @@map("users")
}

model Product {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  colour      String?
  size        String[]
  ownerId     String       @db.ObjectId
  owner       User         @relation(fields: [ownerId], references: [id])
  subCatId    String?      @db.ObjectId
  subCategory SubCategory? @relation(fields: [subCatId], references: [id])
  price       Float
  discount    Float        @default(0)
  category    String
  description String
  imageUrls   String[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  OrderItems  OrderItem[]
  Review      Review[]
  stock       Int

  @@map("products")
}

model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String   @unique
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@map("Categorys")
}

model Order {
  id                String      @id @default(auto()) @map("_id") @db.ObjectId
  userId            String?     @db.ObjectId
  user              User?       @relation("buyer", fields: [userId], references: [id])
  sellerId          String      @db.ObjectId
  seller            User        @relation("seller", fields: [sellerId], references: [id])
  firstName         String?
  lastName          String?
  phone             String
  email             String?
  address           String
  address2          String?
  country           String
  totalAmount       Float
  trackingId        String?
  city              String
  state             String
  postalCode        String
  paymentStatus     Boolean
  Orderitems        OrderItem[]
  paymentIntentId   String?
  paystackReference String?
  status            OrderStatus @default(PENDING)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  size      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Order     Order?   @relation(fields: [orderId], references: [id])
  orderId   String?  @db.ObjectId
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  authorId  String   @db.ObjectId
  Author    User     @relation(fields: [authorId], references: [id])
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id])
  rating    Float
  content   String
  createdAt DateTime @default(now())

  @@unique([authorId, productId])
  @@map("reviews")
}

model Notifications {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  receiverId  String?  @db.ObjectId
  receiver    User?    @relation(fields: [receiverId], references: [id])
  title       String
  description String
  createdAt   DateTime @default(now())

  @@map("notifications")
}

model Transaction {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  paymentId String
  amount    Float
  currency  String
  createdAt DateTime @default(now())

  @@map("transactions")
}

model Draft {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  bookingId          String   @unique @db.ObjectId
  userId             String   @db.ObjectId
  productId          String
  totalEstimatedCost Float
  pricingTier        String
  pickupCharge       Float
  shipmentCharge     Float
  pickupPartner      String
  address            String
  createdAt          DateTime @default(now())

  @@map("drafts")
}

model SubCategory {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  categoryName String    @unique
  createdAt    DateTime  @default(now())
  Product      Product[]

  @@map("subCategories")
}

enum OrderStatus {
  PENDING
  PROCESSED
  SHIPPED
  DELIVERED
}

enum StoreCategory {
  SECONDARY_SCHOOL
  UNIVERSITY
  OTHERS
}

enum UserRoleEnum {
  CUSTOMER
  SELLER
  ADMIN
  SUPERADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  INACTIVATE
  BLOCKED
}
